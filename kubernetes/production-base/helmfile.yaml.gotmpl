{{- $versions := readFile "versions.yaml" | fromYaml -}}
environments:
  starter:
    values:
      - environments/starter.yaml
  production:
    values:
      - environments/production.yaml
  production-ha:
    values:
      - environments/production-ha.yaml
  production-data:
    values:
      - environments/production-data.yaml
  default:
    values:
      - environments/default.yaml
  all-components:
    values:
      - environments/all-components.yaml
  ci:
    values:
      - environments/ci.yaml

---
{{- $versions := readFile "versions.yaml" | fromYaml -}}
{{- $observabilityScope := env "OCF_OBSERVABILITY_SCOPE" | default "trusted" -}}
{{- $identityAccessMode := env "OCF_IDENTITY_ACCESS_MODE" | default "sso" -}}
{{- $cacheAccessMode := env "OCF_CACHE_ACCESS_MODE" | default "acl" -}}
# CRD ownership is singular by design: every chart installs and owns its own
# CRDs (including the Gateway API CRDs, which ship with the Envoy Gateway
# chart), except the Prometheus Operator CRDs, which the apply script installs
# from versions.yaml BEFORE any release because several charts ship
# ServiceMonitors (kube-prometheus-stack disables its copy via crds.enabled).
helmDefaults:
  atomic: true
  cleanupOnFail: true
  createNamespace: true
  wait: true
  timeout: 600

repositories:
  - name: jetstack
    url: {{ $versions.components.certManager.repository | quote }}
  - name: argo
    url: {{ $versions.components.argoCd.repository | quote }}
  - name: cnpg
    url: {{ $versions.components.cloudNativePg.repository | quote }}
  - name: strimzi
    url: {{ $versions.components.strimzi.repository | quote }}
  - name: prometheus-community
    url: {{ $versions.components.kubePrometheusStack.repository | quote }}
  - name: grafana
    url: {{ $versions.components.alloy.repository | quote }}
  - name: grafana-community
    url: {{ $versions.components.grafana.repository | quote }}
  - name: stakater
    url: {{ $versions.components.reloader.repository | quote }}
  - name: zitadel
    url: {{ $versions.components.zitadel.repository | quote }}
  - name: infisical-helm-charts
    url: {{ $versions.components.infisical.repository | quote }}
  - name: valkey-io
    url: {{ $versions.components.valkey.repository | quote }}
  - name: metrics-server
    url: {{ $versions.components.metricsServer.repository | quote }}

releases:
  - name: envoy-gateway
    namespace: envoy-gateway-system
    labels:
      profile: edge
    installed: {{ .Values.profiles.edge }}
    chart: {{ $versions.components.envoyGateway.chart | quote }}
    version: {{ $versions.components.envoyGateway.chartVersion | quote }}
    values:
      - values/envoy-gateway.yaml
{{- if .Values.profiles.highAvailability }}
      - values/production-ha/envoy-gateway.yaml
{{- end }}
{{- if eq .Environment.Name "ci" }}
      - values/ci/envoy-gateway.yaml
{{- end }}

  - name: cert-manager
    namespace: cert-manager
    labels:
      profile: certificates
    installed: {{ .Values.profiles.certificates }}
    chart: jetstack/cert-manager
    version: {{ $versions.components.certManager.chartVersion | quote }}
    # cert-manager's Gateway API integration requires the Gateway CRDs at
    # startup, and those ship with the Envoy Gateway chart.
    needs:
      - envoy-gateway-system/envoy-gateway
    values:
      - values/cert-manager.yaml
{{- if .Values.profiles.highAvailability }}
      - values/production-ha/cert-manager.yaml
{{- end }}
{{- if eq .Environment.Name "ci" }}
      - values/ci/cert-manager.yaml
{{- end }}

  - name: argocd
    namespace: argocd
    labels:
      profile: gitops
    installed: {{ .Values.profiles.gitops }}
    chart: argo/argo-cd
    version: {{ $versions.components.argoCd.chartVersion | quote }}
    missingFileHandler: Info
    values:
      - values/argocd.yaml
{{- if .Values.profiles.highAvailability }}
      - values/production-ha/argocd.yaml
{{- end }}
{{- if eq $identityAccessMode "legacy" }}
      - values/legacy/argocd.yaml
{{- end }}
      - values/local/argocd.yaml
{{- if eq .Environment.Name "ci" }}
      - values/ci/argocd.yaml
{{- end }}

  - name: cloudnative-pg
    namespace: cnpg-system
    labels:
      profile: postgres
    installed: {{ .Values.profiles.postgresOperator }}
    chart: cnpg/cloudnative-pg
    version: {{ $versions.components.cloudNativePg.chartVersion | quote }}
    values:
      - values/cloudnative-pg.yaml
{{- if .Values.profiles.highAvailability }}
      - values/production-ha/cloudnative-pg.yaml
{{- end }}
{{- if eq .Environment.Name "ci" }}
      - values/ci/cloudnative-pg.yaml
{{- end }}

  - name: strimzi-kafka-operator
    namespace: strimzi-system
    labels:
      profile: messaging
    installed: {{ .Values.profiles.messagingOperators }}
    chart: strimzi/strimzi-kafka-operator
    version: {{ $versions.components.strimzi.chartVersion | quote }}
    values:
      - values/strimzi-kafka-operator.yaml
{{- if .Values.profiles.highAvailability }}
      - values/production-ha/strimzi-kafka-operator.yaml
{{- end }}

  - name: kube-prometheus-stack
    namespace: monitoring
    labels:
      profile: observability
    installed: {{ .Values.profiles.observability }}
    chart: prometheus-community/kube-prometheus-stack
    version: {{ $versions.components.kubePrometheusStack.chartVersion | quote }}
    # values/local/kube-prometheus-stack.yaml (gitignored) carries instance settings such as
    # retention and alert receivers; helmfile skips it when absent.
    missingFileHandler: Info
    values:
      - values/kube-prometheus-stack.yaml
{{- if .Values.profiles.highAvailability }}
      - values/production-ha/kube-prometheus-stack.yaml
{{- end }}
{{- if eq $observabilityScope "trusted" }}
      - values/trusted/kube-prometheus-stack.yaml
{{- end }}
      - values/local/kube-prometheus-stack.yaml
{{- if eq .Environment.Name "ci" }}
      - values/ci/kube-prometheus-stack.yaml
{{- end }}

  # Serves metrics.k8s.io for kubectl top and HPA. Installed here instead of
  # the OKE managed addon: the addon now depends on the CertManager addon,
  # which would fight the cert-manager release above for the same CRDs.
  - name: metrics-server
    namespace: kube-system
    labels:
      profile: observability
    installed: {{ .Values.profiles.observability }}
    chart: metrics-server/metrics-server
    version: {{ $versions.components.metricsServer.chartVersion | quote }}
    values:
      - values/metrics-server.yaml
{{- if .Values.profiles.highAvailability }}
      - values/production-ha/metrics-server.yaml
{{- end }}
{{- if eq .Environment.Name "ci" }}
      - values/ci/metrics-server.yaml
{{- end }}

  # Synthetic probes: Probe resources point Prometheus at this exporter to check
  # public endpoints from inside the cluster (availability, latency, TLS expiry).
  - name: blackbox-exporter
    namespace: monitoring
    labels:
      profile: observability
    installed: {{ .Values.profiles.observability }}
    chart: prometheus-community/prometheus-blackbox-exporter
    version: {{ $versions.components.blackboxExporter.chartVersion | quote }}
    values:
      - values/blackbox-exporter.yaml
{{- if .Values.profiles.highAvailability }}
      - values/production-ha/blackbox-exporter.yaml
{{- end }}

  - name: loki
    namespace: monitoring
    labels:
      profile: observability
    installed: {{ .Values.profiles.observability }}
    chart: grafana-community/loki
    version: {{ $versions.components.loki.chartVersion | quote }}
    # values/local/loki.yaml (gitignored) carries instance settings such as
    # retention and alert receivers; helmfile skips it when absent.
    missingFileHandler: Info
    values:
      - values/loki.yaml
{{- if .Values.profiles.durableObservability }}
      - values/production-ha/loki.yaml
{{- end }}
      - values/local/loki.yaml

  - name: tempo
    namespace: monitoring
    labels:
      profile: observability
    installed: {{ and .Values.profiles.observability (not .Values.profiles.durableObservability) }}
    chart: grafana-community/tempo
    version: {{ $versions.components.tempo.chartVersion | quote }}
    # values/local/tempo.yaml (gitignored) carries instance settings such as
    # retention and alert receivers; helmfile skips it when absent.
    missingFileHandler: Info
    values:
      - values/tempo.yaml
      - values/local/tempo.yaml

  - name: tempo-distributed
    namespace: monitoring
    labels:
      profile: observability
    installed: {{ and .Values.profiles.observability .Values.profiles.durableObservability }}
    chart: grafana-community/tempo-distributed
    version: {{ $versions.components.tempoDistributed.chartVersion | quote }}
    missingFileHandler: Info
    values:
      - values/production-ha/tempo-distributed.yaml
      - values/local/tempo-distributed.yaml

  - name: alloy
    namespace: monitoring
    labels:
      profile: observability
    installed: {{ .Values.profiles.observability }}
    chart: grafana/alloy
    version: {{ $versions.components.alloy.chartVersion | quote }}
    # values/local/alloy.yaml (gitignored) carries instance settings such as
    # retention and alert receivers; helmfile skips it when absent.
    missingFileHandler: Info
    values:
      - values/alloy.yaml.gotmpl
      - values/local/alloy.yaml

  - name: grafana
    namespace: monitoring
    labels:
      profile: observability
    installed: {{ .Values.profiles.observability }}
    chart: grafana-community/grafana
    version: {{ $versions.components.grafana.chartVersion | quote }}
    needs:
      - monitoring/kube-prometheus-stack
      - monitoring/loki
{{- if .Values.profiles.durableObservability }}
      - monitoring/tempo-distributed
      - monitoring/thanos
{{- else }}
      - monitoring/tempo
{{- end }}
    # values/local/*.yaml carries instance-specific settings (public URL, OIDC
    # issuer) and is gitignored; helmfile skips it when absent.
    missingFileHandler: Info
    values:
      - values/grafana.yaml
{{- if .Values.profiles.highAvailability }}
      - values/production-ha/grafana.yaml
{{- end }}
{{- if eq $identityAccessMode "legacy" }}
      - values/legacy/grafana.yaml
{{- end }}
{{- if eq $observabilityScope "trusted" }}
      - values/trusted/grafana.yaml
{{- end }}
      - values/local/grafana.yaml
{{- if eq .Environment.Name "ci" }}
      - values/ci/grafana.yaml
{{- end }}

  - name: reloader
    namespace: reloader
    labels:
      profile: reloader
    installed: true
    chart: stakater/reloader
    version: {{ $versions.components.reloader.chartVersion | quote }}
    values:
      - values/reloader.yaml
{{- if .Values.profiles.highAvailability }}
      - values/production-ha/reloader.yaml
{{- end }}
{{- if eq .Environment.Name "ci" }}
      - values/ci/reloader.yaml
{{- end }}

  - name: thanos
    namespace: monitoring
    labels:
      profile: observability
    installed: {{ and .Values.profiles.observability .Values.profiles.durableObservability }}
    chart: charts/thanos
    needs:
      - monitoring/kube-prometheus-stack
    values:
      - values/production-ha/thanos.yaml

  - name: production-ha-policies
    namespace: platform-system
    labels:
      profile: high-availability
    installed: {{ .Values.profiles.highAvailability }}
    chart: charts/production-ha-policies
    needs:
      - cnpg-system/cloudnative-pg

  - name: valkey
    namespace: cache
    labels:
      profile: cache
    installed: {{ .Values.profiles.cache }}
    chart: valkey-io/valkey
    version: {{ $versions.components.valkey.chartVersion | quote }}
    values:
      - values/valkey.yaml
{{- if eq $cacheAccessMode "legacy" }}
      - values/legacy/valkey.yaml
{{- end }}

  - name: zitadel
    namespace: identity
    labels:
      profile: identity
    installed: {{ .Values.profiles.identity }}
    chart: zitadel/zitadel
    version: {{ $versions.components.zitadel.chartVersion | quote }}
    missingFileHandler: Info
    values:
      - values/zitadel.yaml
      - values/local/zitadel.yaml
    strategicMergePatches:
      - patches/zitadel.yaml
      - patches/zitadel-login.yaml

  - name: infisical
    namespace: secrets
    labels:
      profile: secrets
    installed: {{ .Values.profiles.secrets }}
    chart: infisical-helm-charts/infisical-standalone
    version: {{ $versions.components.infisical.chartVersion | quote }}
    missingFileHandler: Info
    values:
      - values/infisical.yaml
      - values/local/infisical.yaml
    strategicMergePatches:
      - patches/infisical.yaml

  - name: infisical-platform
    namespace: secrets
    labels:
      profile: secrets
    installed: {{ .Values.profiles.secrets }}
    chart: charts/infisical-platform
    needs:
      - secrets/infisical
    missingFileHandler: Info
    values:
      - values/infisical-platform.yaml
      - values/local/infisical.yaml
